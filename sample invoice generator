// --- PRIMARY EXPORTED FUNCTIONS ---
export function initialize() {
  if (isInitialized) {
    openInvoiceEditor();
    return;
  }

  // Assign DOM elements to module-scoped variables
  overlay = document.getElementById('cib-invoice-overlay');
  canvas = document.getElementById('cib-invoice-canvas');
  templateNameInput = document.getElementById('cib-template-name-input');
  loadTemplateSelect = document.getElementById('cib-load-template-select');

  if (!overlay || !canvas) return console.error("Could not initialize: Invoice overlay or canvas not found.");

  loadUserPreferences();
  setupAllListeners();
  loadInitialCanvasState();
  populateTemplateSelector();

  openInvoiceEditor();
  isInitialized = true;
}

export function closeInvoiceEditor() {
  if (overlay && !overlay.classList.contains('invoice-overlay-hidden')) {
    hideOverlay();

    // Clean up URL hash if needed (Mobile Back Button support)
    if (window.location.hash === "#invoice-editor") {
        window.history.back();
    }
  }
}


