# Site theme. Edit freely; restart `make dev` (Vite) after changing.
# Any value is a normal CSS value. Delete a line to fall back to the default.
VITE_THEME_COLOR_1=#0d1b36
VITE_THEME_COLOR_2=#16305f
VITE_THEME_COLOR_ACCENT=#5aa2ff
VITE_THEME_FONT=system-ui, -apple-system, "Segoe UI", sans-serif
VITE_THEME_ICON_SIZE=1.4rem

# Contact details shown on the home page (sample values for now).
VITE_CONTACT_EMAIL=hello@example.co.nz
VITE_CONTACT_PHONE=0800 000 000
VITE_CONTACT_ADDRESS=Level 1, 123 Sample Street, Wellington 6011
