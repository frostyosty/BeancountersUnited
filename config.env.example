# Copy to config.env (gitignored) for local runs. Real environment variables win over this file.
#
# Site PIN gate: a keypad shown before anything else, to discourage casual snooping.
# Digits only. Leave it blank or delete the line to turn the gate off.
ACCT_SITE_PIN=1223
#
# On Fly.io config.env isn't deployed; set it as a secret instead:
#   fly secrets set ACCT_SITE_PIN=1234      (turn off: fly secrets unset ACCT_SITE_PIN)
