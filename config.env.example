# Copy to config.env (gitignored). Read when the web app is built (make dev, pnpm build, fly deploy).
# Real environment variables of the same name win over this file.

# on  = public site hidden behind the 5-tap header, and kept out of search (noindex, robots.txt blocks all).
# off = site open to everyone, with search/AI-crawler tags, a plain-HTML summary, robots.txt and a sitemap.
# If this file is missing the gate is on.
SITE_GATE=on

# The public address, used in canonical links and the sitemap.
SITE_URL=https://acct-test.fly.dev
