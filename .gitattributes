# Snapshot files are compared byte-for-byte by tests, so keep LF on every platform.
*.snap text eol=lf

release text eol=lf

# The PDF template is compiled into the binary; its bytes decide the PDF bytes (ADR 010).
*.typ text eol=lf
crates/store/migrations/*.sql text eol=lf

# OFX edge-case fixtures hold deliberate CR-only, CRLF and Windows-1252 bytes: never convert them.
fixtures/bank-statements/ofx-edge/* -text

# Landing examples (M20) show both LF and CRLF downloads on purpose: never convert them.
fixtures/landing/*.ofx -text

# PDFs (the sample statements in apps/web/public/samples) are binary: never convert their line endings.
*.pdf binary
