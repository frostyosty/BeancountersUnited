{
    "port": 8081,
    "codebase": "..",
    "registry": "app-tauri-browser/src/js/core/icon_registry.js",
    "registry_variable": "window.OS_ICON_REGISTRY",
    "web_root": "app-tauri-browser/src",
    "icons_dir": "app-tauri-browser/src/assets/icons",
    "scan": {
        "dirs": ["app-tauri-browser/src", "app-tauri-browser/config", "app-tauri-browser/plugins", "app-tauri-browser/src-tauri/src"],
        "extensions": [".html", ".js", ".mjs", ".css", ".csv", ".json", ".rs", ".kt"],
        "skip_dirs": ["node_modules", "vendor", "target", "gen", "dist", "build", ".git"]
    }
}
